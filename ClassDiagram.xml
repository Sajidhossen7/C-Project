<mxfile host="app.diagrams.net">
  <diagram name="PSSMS UML Class Diagram">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1"
      tooltips="1" connect="1" arrows="1" fold="1" page="1"
      pageScale="1" pageWidth="1600" pageHeight="1200">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- User -->
        <mxCell id="user" value="User&#xa;----------------&#xa;- userId&#xa;- name&#xa;- username&#xa;- password&#xa;- email&#xa;- phone&#xa;- role&#xa;----------------&#xa;+ login()&#xa;+ logout()&#xa;+ updateProfile()&#xa;+ changePassword()&#xa;+ recoverPassword()"
          style="rounded=1;whiteSpace=wrap;html=1;"
          vertex="1" parent="1">
          <mxGeometry x="600" y="40" width="260" height="260" as="geometry"/>
        </mxCell>

        <!-- Subclasses -->
        <mxCell id="admin" value="Admin&#xa;+ addUser()&#xa;+ deleteUser()&#xa;+ assignRole()&#xa;+ approveStock()&#xa;+ generateReport()"
          style="rounded=1;whiteSpace=wrap;html=1;"
          vertex="1" parent="1">
          <mxGeometry x="300" y="350" width="220" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="pharmacist" value="Pharmacist&#xa;+ addMedicine()&#xa;+ updateMedicine()&#xa;+ removeMedicine()&#xa;+ sendStockRequest()&#xa;+ checkExpiry()"
          style="rounded=1;whiteSpace=wrap;html=1;"
          vertex="1" parent="1">
          <mxGeometry x="550" y="350" width="260" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="cashier" value="Cashier&#xa;+ createBill()&#xa;+ generateInvoice()&#xa;+ recordPayment()&#xa;+ submitSalesReport()"
          style="rounded=1;whiteSpace=wrap;html=1;"
          vertex="1" parent="1">
          <mxGeometry x="850" y="350" width="250" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="supplier" value="Supplier&#xa;+ updateDeliveryStatus()&#xa;+ provideInvoice()&#xa;+ updatePricing()&#xa;+ negotiatePrice()"
          style="rounded=1;whiteSpace=wrap;html=1;"
          vertex="1" parent="1">
          <mxGeometry x="300" y="580" width="260" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="customer" value="Customer&#xa;+ viewMedicines()&#xa;+ viewInvoices()&#xa;+ placeOrder()"
          style="rounded=1;whiteSpace=wrap;html=1;"
          vertex="1" parent="1">
          <mxGeometry x="850" y="580" width="230" height="160" as="geometry"/>
        </mxCell>

        <!-- Medicine -->
        <mxCell id="medicine" value="Medicine&#xa;----------------&#xa;- medicineId&#xa;- name&#xa;- batchNo&#xa;- expiryDate&#xa;- price&#xa;- quantity&#xa;----------------&#xa;+ updatePrice()&#xa;+ updateQuantity()&#xa;+ checkExpiry()"
          style="rounded=1;whiteSpace=wrap;html=1;"
          vertex="1" parent="1">
          <mxGeometry x="50" y="40" width="260" height="260" as="geometry"/>
        </mxCell>

        <!-- Inventory -->
        <mxCell id="inventory" value="Inventory&#xa;----------------&#xa;- inventoryId&#xa;- lastUpdated&#xa;- medicineList&#xa;----------------&#xa;+ addStock()&#xa;+ reduceStock()&#xa;+ checkAvailability()&#xa;+ lowStockAlert()"
          style="rounded=1;whiteSpace=wrap;html=1;"
          vertex="1" parent="1">
          <mxGeometry x="50" y="350" width="260" height="240" as="geometry"/>
        </mxCell>

        <!-- Sale -->
        <mxCell id="sale" value="Sale&#xa;----------------&#xa;- saleId&#xa;- date&#xa;- totalAmount&#xa;----------------&#xa;+ calculateTotal()&#xa;+ validateSale()&#xa;+ saveSale()"
          style="rounded=1;whiteSpace=wrap;html=1;"
          vertex="1" parent="1">
          <mxGeometry x="1150" y="40" width="260" height="220" as="geometry"/>
        </mxCell>

        <!-- Invoice -->
        <mxCell id="invoice" value="Invoice&#xa;----------------&#xa;- invoiceId&#xa;- date&#xa;- totalAmount&#xa;----------------&#xa;+ generateInvoice()&#xa;+ printInvoice()&#xa;+ viewInvoice()"
          style="rounded=1;whiteSpace=wrap;html=1;"
          vertex="1" parent="1">
          <mxGeometry x="1150" y="320" width="260" height="220" as="geometry"/>
        </mxCell>

        <!-- Payment -->
        <mxCell id="payment" value="Payment&#xa;----------------&#xa;- paymentId&#xa;- amount&#xa;- paymentMethod&#xa;- paymentDate&#xa;----------------&#xa;+ processPayment()&#xa;+ validatePayment()"
          style="rounded=1;whiteSpace=wrap;html=1;"
          vertex="1" parent="1">
          <mxGeometry x="1150" y="600" width="260" height="220" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
